DEFINE PANEL UPFlowCantinaEngenharia
    WITH TITLE "UPFlow - Cantina de Engenharia"
    WITH VISIBILITY PUBLIC
    WITH STATE PUBLISHED
    WITH LAYOUT "grid" COLUMNS 2 ROWS 3
    WITH THEME "dark"
    ADD COMPONENT "ocupacao" WITH TYPE "gauge" AT COLUMN 1 ROW 2
        SET LABEL "Ocupacao atual"
        SET UNIT "%"
        SET THRESHOLD_MODE "gradient"
        ADD THRESHOLD AT 25 WITH COLOR "#33d17a"
        ADD THRESHOLD AT 50 WITH COLOR "#ff7800"
        ADD THRESHOLD AT 100 WITH COLOR "#e01b24"
        BIND VALUE TO TOPIC "upflow/v1/feup/cantina_engenharia/processed/percentage"
    ADD COMPONENT "historico" WITH TYPE "realtime-chart" AT COLUMN 2 ROW 2
        SET LABEL "Evolução da ocupação"
        SET UNIT "%"
        SET TIME_WINDOW "100000"
        BIND VALUE TO TOPIC "upflow/v1/feup/cantina_engenharia/processed/percentage"
    ADD COMPONENT "voltar" WITH TYPE "button" AT COLUMN 2 ROW 1
        SET LABEL "Voltar"
        ON CLICK DO NAVIGATE TO PANEL "UPFlowFEUP"
    ADD COMPONENT "toggle3" WITH TYPE "toggle"
        SET LABEL "Favorito"
        BIND STATE TO TOPIC "upflow/v1/demo/favorites/cantina_engenharia/visible"
        ON CHANGE DO PUBLISH TOPIC "upflow/v1/demo/favorites/cantina_engenharia/visible" WITH FALSE
        ON TOGGLE DO PUBLISH TOPIC "upflow/v1/demo/favorites/cantina_engenharia/visible" WITH TRUE
    ADD COMPONENT "map1" WITH TYPE "map" AT COLUMN 1 ROW 3 SPAN 2 COLUMNS
        SET LABEL "Map"
        SET ZOOM 200
        SET CENTER_LAT 41.17621448868454
        SET CENTER_LON -8.595469315713661