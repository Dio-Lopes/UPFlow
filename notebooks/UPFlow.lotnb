[
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE ACTION UPFlowProcessReading\nON TOPIC \"upflow/v1/+/+/raw/reading\" DO\n    SET \"campus\" WITH TOPIC POSITION 3\n    SET \"venue\" WITH TOPIC POSITION 4\n    SET \"occupied\" WITH (GET JSON \"occupied\" IN PAYLOAD AS INT)\n    SET \"capacity\" WITH (GET JSON \"capacity\" IN PAYLOAD AS INT)\n    SET \"observed\" WITH (GET JSON \"observed_at\" IN PAYLOAD AS STRING)\n    SET \"percent\" WITH 0.0\n    SET \"status\" WITH \"invalid\"\n    IF {capacity} > 0 THEN\n        IF {occupied} >= 0 THEN\n            IF {occupied} <= {capacity} THEN\n                SET \"percent\" WITH ({occupied} * 100.0 / {capacity})\n                SET \"status\" WITH \"quiet\"\n                IF {percent} >= 80.0 THEN\n                    SET \"status\" WITH \"busy\"\n                ELSE IF {percent} >= 50.0 THEN\n                    SET \"status\" WITH \"moderate\"\n    PUBLISH TOPIC \"upflow/v1/\" + {campus} + \"/\" + {venue} + \"/processed/status\" WITH {status}\n    PUBLISH TOPIC \"upflow/v1/\" + {campus} + \"/\" + {venue} + \"/processed/occupied\" WITH {occupied}\n    PUBLISH TOPIC \"upflow/v1/\" + {campus} + \"/\" + {venue} + \"/processed/capacity\" WITH {capacity}\n    PUBLISH TOPIC \"upflow/v1/\" + {campus} + \"/\" + {venue} + \"/processed/percentage\" WITH {percent}\n    PUBLISH TOPIC \"upflow/v1/\" + {campus} + \"/\" + {venue} + \"/processed/observed_at\" WITH {observed}"
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE PANEL UPFlowBarMinas\n    WITH TITLE \"UPFlow - Bar de Minas\"\n    WITH VISIBILITY PUBLIC\n    WITH STATE PUBLISHED\n    WITH LAYOUT \"grid\" COLUMNS 2 ROWS 3\n    WITH THEME \"dark\"\n    ADD COMPONENT \"ocupação\" WITH TYPE \"gauge\" AT COLUMN 1 ROW 2\n        SET LABEL \"Ocupação atual\"\n        SET UNIT \"%\"\n        SET THRESHOLD_MODE \"gradient\"\n        ADD THRESHOLD AT 25 WITH COLOR \"#33d17a\"\n        ADD THRESHOLD AT 50 WITH COLOR \"#ff7800\"\n        ADD THRESHOLD AT 100 WITH COLOR \"#e01b24\"\n        BIND VALUE TO TOPIC \"upflow/v1/feup/bar_minas/processed/percentage\"\n    ADD COMPONENT \"historico\" WITH TYPE \"realtime-chart\" AT COLUMN 2 ROW 2\n        SET SHOW_LEGEND \"false\"\n        SET LABEL \"Evolução da ocupação\"\n        SET UNIT \"%\"\n        SET TIME_WINDOW \"100000\"\n        BIND VALUE TO TOPIC \"upflow/v1/feup/bar_minas/processed/percentage\"\n    ADD COMPONENT \"voltar\" WITH TYPE \"button\" AT COLUMN 2 ROW 1\n        SET LABEL \"Voltar\"\n        ON CLICK DO NAVIGATE TO PANEL \"UPFlowFEUP\"\n    ADD COMPONENT \"toggle3\" WITH TYPE \"toggle\"\n        SET LABEL \"Favorito\"\n        BIND STATE TO TOPIC \"upflow/v1/demo/favorites/bar_minas/visible\"\n        ON CHANGE DO PUBLISH TOPIC \"upflow/v1/demo/favorites/bar_minas/visible\" WITH FALSE\n        ON TOGGLE DO PUBLISH TOPIC \"upflow/v1/demo/favorites/bar_minas/visible\" WITH TRUE\n    ADD COMPONENT \"map1\" WITH TYPE \"map\" AT COLUMN 1 ROW 3 SPAN 2 COLUMNS\n        SET LABEL \"Map\"\n        SET ZOOM 200\n        SET CENTER_LAT 41.17854611553646\n        SET CENTER_LON -8.597470905990656"
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE PANEL UPFlowHome\n    WITH TITLE \"UPFlow\"\n    WITH VISIBILITY PUBLIC\n    WITH STATE PUBLISHED\n    WITH LAYOUT \"grid\" COLUMNS 3 ROWS 3\n    WITH THEME \"dark\"\n    ADD COMPONENT \"tituloFavoritos\" WITH TYPE \"header\" AT COLUMN 1 ROW 1\n        SET CONTENT \"Os meus favoritos\"\n        SET VISIBLE TRUE\n    ADD COMPONENT \"gauge1\" WITH TYPE \"gauge\" AT COLUMN 1 ROW 2\n        SET LABEL \"Cantina de Engenharia\"\n        SET UNIT \"%\"\n        SET THRESHOLD_MODE \"gradient\"\n        SET VISIBLE TRUE\n        ADD THRESHOLD AT 25 WITH COLOR \"#33d17a\"\n        ADD THRESHOLD AT 50 WITH COLOR \"#ff7800\"\n        ADD THRESHOLD AT 100 WITH COLOR \"#e01b24\"\n        BIND VALUE TO TOPIC \"upflow/v1/feup/cantina_engenharia/processed/percentage\"\n    ADD COMPONENT \"gauge2\" WITH TYPE \"gauge\" AT COLUMN 2 ROW 2\n        SET Z_INDEX 0\n        SET LABEL \"Bar de Minas\"\n        SET UNIT \"%\"\n        SET THRESHOLD_MODE \"gradient\"\n        SET VISIBLE FALSE\n        SET OPACITY 0\n        ADD THRESHOLD AT 25 WITH COLOR \"#33d17a\"\n        ADD THRESHOLD AT 50 WITH COLOR \"#ff7800\"\n        ADD THRESHOLD AT 100 WITH COLOR \"#e01b24\"\n        BIND VALUE TO TOPIC \"upflow/v1/feup/bar_minas/processed/percentage\"\n    ADD COMPONENT \"feupButton\" WITH TYPE \"button\" AT COLUMN 1 ROW 3\n        SET LABEL \"Explorar FEUP\"\n        ON CLICK DO NAVIGATE TO PANEL \"UPFlowFEUP\""
  },
  {
    "kind": 2,
    "language": "lot",
    "value": "DEFINE PANEL UPFlowFEUP\n    WITH TITLE \"UPFlow - FEUP\"\n    WITH VISIBILITY PUBLIC\n    WITH STATE PUBLISHED\n    WITH LAYOUT \"grid\" COLUMNS 3 ROWS 2\n    WITH THEME \"dark\"\n    ADD COMPONENT \"barMinas\" WITH TYPE \"button\" AT COLUMN 1 ROW 1\n        SET LABEL \"Bar de Minas\"\n        ON CLICK DO NAVIGATE TO PANEL \"UPFlowBarMinas\"\n    ADD COMPONENT \"cantina\" WITH TYPE \"button\" AT COLUMN 2 ROW 1\n        SET LABEL \"Cantina de Engenharia\"\n        ON CLICK DO NAVIGATE TO PANEL \"UPFlowCantinaEngenharia\"\n    ADD COMPONENT \"grill\" WITH TYPE \"button\" AT COLUMN 3 ROW 1\n        SET LABEL \"Grill de Engenharia\"\n        ON CLICK DO NAVIGATE TO PANEL \"UPFlowGrillEngenharia\"\n    ADD COMPONENT \"voltar\" WITH TYPE \"button\" AT COLUMN 1 ROW 2\n        SET LABEL \"Voltar\"\n        ON CLICK DO NAVIGATE TO PANEL \"UPFlowHome\""
  },
