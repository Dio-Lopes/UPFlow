-- Painel para o Dashboard Manager do Coreflux HUB.
-- Valores percentuais numéricos devem chegar a processed/percentage.
-- PUBLIC permite divulgação; confirmar permissões antes de partilhar.
DEFINE PANEL UPFlowDashboard
WITH VISIBILITY PUBLIC
WITH STATE PUBLISHED
WITH TITLE "UPFlow - Ocupacao Simulada"
WITH LAYOUT "grid" COLUMNS 3

    ADD COMPONENT "BarMinas" WITH TYPE "gauge"
        SET RANGE FROM 0 TO 100
        SET UNIT "%"
        BIND VALUE TO TOPIC "upflow/v1/feup/bar_minas/processed/percentage"
        ADD THRESHOLD AT 80 WITH COLOR "warning"

    ADD COMPONENT "CantinaEngenharia" WITH TYPE "gauge"
        SET RANGE FROM 0 TO 100
        SET UNIT "%"
        BIND VALUE TO TOPIC "upflow/v1/feup/cantina_engenharia/processed/percentage"
        ADD THRESHOLD AT 80 WITH COLOR "warning"

    ADD COMPONENT "GrillEngenharia" WITH TYPE "gauge"
        SET RANGE FROM 0 TO 100
        SET UNIT "%"
        BIND VALUE TO TOPIC "upflow/v1/feup/grill_engenharia/processed/percentage"
        ADD THRESHOLD AT 80 WITH COLOR "warning"

    ADD COMPONENT "BarMinasTrend" WITH TYPE "realtime-chart"
        SET LABEL "Evolucao - Bar de Minas"
        SET UNIT "%"
        BIND VALUE TO TOPIC "upflow/v1/feup/bar_minas/processed/percentage"
